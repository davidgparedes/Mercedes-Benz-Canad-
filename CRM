<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mercedes-Benz Canada - CRM/PRM Portal</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 font-sans text-gray-800">

    <div class="hidden bg-red-50 text-red-900 bg-green-50 text-green-900 border-red-200 border-green-200"></div>

    <div class="flex h-screen overflow-hidden">

        <div class="w-64 bg-slate-900 text-white flex flex-col justify-between">
            <div class="p-5">
                <h1 class="text-xl font-bold tracking-wider text-center border-b border-slate-700 pb-4">
                    Mercedes-Benz <br><span class="text-sm font-light text-slate-400">HQ - Toronto Hub</span>
                </h1>
                <nav class="mt-6 space-y-2">
                    <button onclick="switchTab('dashboard')" id="btn-dashboard" class="w-full text-left py-2.5 px-4 rounded bg-slate-800 font-medium transition-colors">
                        📊 Central de Monitoreo
                    </button>
                    <button onclick="switchTab('crm')" id="btn-crm" class="w-full text-left py-2.5 px-4 rounded hover:bg-slate-800 text-slate-300 transition-colors">
                        👤 CRM (Datos de Cliente)
                    </button>
                    <button onclick="switchTab('prm')" id="btn-prm" class="w-full text-left py-2.5 px-4 rounded hover:bg-slate-800 text-slate-300 transition-colors">
                        🤝 PRM (Incentivo de Red)
                    </button>
                    <button onclick="switchTab('analytics')" id="btn-analytics" class="w-full text-left py-2.5 px-4 rounded hover:bg-slate-800 text-slate-300 transition-colors">
                        📈 Herramientas Estadísticas
                    </button>
                    <button onclick="switchTab('decision')" id="btn-decision" class="w-full text-left py-2.5 px-4 rounded hover:bg-slate-800 text-slate-300 transition-colors">
                        🌳 Decisión Financiera
                    </button>
                </nav>
            </div>
            <div class="p-4 bg-slate-950 text-xs text-slate-400 text-center">
                Ecosistema de Incentivos v2.1
            </div>
        </div>

        <div class="flex-1 flex flex-col overflow-y-auto">
            
            <header class="bg-white shadow-sm px-8 py-4 flex justify-between items-center">
                <h2 id="page-title" class="text-2xl font-bold text-gray-800">Central de Monitoreo</h2>
                <div class="text-sm text-red-600 font-bold bg-red-50 px-3 py-1 rounded border border-red-200">
                    Caso: Romper Silos de Información en Concesionarios
                </div>
            </header>

            <main class="p-8 space-y-6">

                <div id="tab-dashboard" class="tab-content space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="bg-white p-5 rounded-lg shadow-sm border-l-4 border-blue-600">
                            <p class="text-xs font-bold text-gray-400 uppercase">Concesionarios Conectados</p>
                            <p id="kpi-total-dealers" class="text-3xl font-extrabold mt-1">0 / 55</p>
                        </div>
                        <div class="bg-white p-5 rounded-lg shadow-sm border-l-4 border-emerald-600">
                            <p class="text-xs font-bold text-gray-400 uppercase">Índice de Compartición de Datos</p>
                            <p id="kpi-data-index" class="text-3xl font-extrabold mt-1">0%</p>
                        </div>
                        <div class="bg-white p-5 rounded-lg shadow-sm border-l-4 border-yellow-500">
                            <p class="text-xs font-bold text-gray-400 uppercase">Clientes Consolidados (CRM)</p>
                            <p id="kpi-total-clients" class="text-3xl font-extrabold mt-1">0</p>
                        </div>
                        <div class="bg-white p-5 rounded-lg shadow-sm border-l-4 border-purple-600">
                            <p class="text-xs font-bold text-gray-400 uppercase">Bonos por Incentivo Otorgados</p>
                            <p id="kpi-incentives-unlocked" class="text-3xl font-extrabold mt-1">0</p>
                        </div>
                    </div>

                    <div class="bg-amber-50 border border-amber-200 p-6 rounded-lg text-amber-900">
                        <h3 class="text-lg font-bold mb-1">🎯 Justificación de la Arquitectura Operativa</h3>
                        <p class="text-sm leading-relaxed">
                            Detectamos que las agencias retenían los datos por falta de obligatoriedad e incentivos. Esta plataforma implementa un sistema donde los concesionarios ganan acceso a <strong>Leads Corporativos Exclusivos de Planta</strong> y un <strong>Bono de Comisión (+2%)</strong> únicamente si su <em>Tasa de Compartición de Datos</em> supera el 70%.
                        </p>
                    </div>
                </div>

                <div id="tab-crm" class="tab-content space-y-6 hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="bg-white p-6 rounded-lg shadow-sm h-fit">
                            <h3 class="text-lg font-bold mb-4 border-b pb-2">Capturar Cliente Final (Interfaz Concesionario)</h3>
                            <form id="form-crm" class="space-y-4" onsubmit="addClient(event)">
                                <div>
                                    <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Nombre del Comprador</label>
                                    <input type="text" id="crm-name" required class="w-full border p-2 rounded text-sm focus:outline-slate-800">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Contacto / Email</label>
                                    <input type="email" id="crm-email" required class="w-full border p-2 rounded text-sm focus:outline-slate-800">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Vehículo Adquirido o de Interés</label>
                                    <select id="crm-model" class="w-full border p-2 rounded text-sm focus:outline-slate-800">
                                        <option value="Mercedes-Benz EQE Sedan">Mercedes-Benz EQE Sedan</option>
                                        <option value="Mercedes-AMG SL Roadster">Mercedes-AMG SL Roadster</option>
                                        <option value="Mercedes-Benz Clase G">Mercedes-Benz Clase G</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Agencia Originaria</label>
                                    <select id="crm-dealer-origin" class="w-full border p-2 rounded text-sm focus:outline-slate-800">
                                        </select>
                                </div>
                                <button type="submit" class="w-full bg-slate-900 text-white font-bold py-2 rounded text-sm hover:bg-slate-800 transition-colors">
                                    Transmitir Registro a Planta (HQ)
                                </button>
                            </form>
                        </div>
                        <div class="bg-white p-6 rounded-lg shadow-sm lg:col-span-2">
                            <h3 class="text-lg font-bold mb-4 border-b pb-2">Datos Consolidados en HQ (Historial Único)</h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-sm">
                                    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
                                        <tr>
                                            <th class="p-3">Cliente</th>
                                            <th class="p-3">Vehículo</th>
                                            <th class="p-3">Transmitido por Concesionario</th>
                                            <th class="p-3 text-right">Estado del Registro</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-crm-body" class="divide-y">
                                        </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="tab-prm" class="tab-content space-y-6 hidden">
                    <div class="bg-white p-6 rounded-lg shadow-sm">
                        <div class="flex justify-between items-center mb-4 border-b pb-2">
                            <h3 class="text-lg font-bold">Auditoría de la Red de Distribución (Estrategia de Incentivos)</h3>
                            <button onclick="simulateDataSync()" class="bg-emerald-600 text-white font-bold text-xs px-3 py-1.5 rounded hover:bg-emerald-700 transition-all">
                                🔄 Simular Carga Masiva de Datos (Activar Concesionarios)
                            </button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-slate-100 text-slate-700 uppercase text-xs font-bold">
                                    <tr>
                                        <th class="p-3">Concesionario Autorizado</th>
                                        <th class="p-3">Región Operativa</th>
                                        <th class="p-3">Tasa de Envío de Datos</th>
                                        <th class="p-3">Bono de Comisión Actual</th>
                                        <th class="p-3">Incentivo Corporativo (Leads VIP)</th>
                                    </tr>
                                </thead>
                                <tbody id="table-prm-body" class="divide-y">
                                    </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div id="tab-analytics" class="tab-content space-y-6 hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white p-6 rounded-lg shadow-sm">
                            <h3 class="text-lg font-bold mb-2 text-slate-900">Planificación del Módulo de Integración (PERT)</h3>
                            <p class="text-xs text-gray-500 mb-4">Optimización del desarrollo para conectar los 55 puntos de venta en Canadá.</p>
                            <div class="space-y-3">
                                <div class="grid grid-cols-3 gap-2">
                                    <div>
                                        <label class="block text-xs text-gray-600">Optimista (O)</label>
                                        <input type="number" id="pert-o" value="4" class="w-full border p-2 rounded text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-600">Probable (M)</label>
                                        <input type="number" id="pert-m" value="8" class="w-full border p-2 rounded text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-xs text-gray-600">Pesimista (P)</label>
                                        <input type="number" id="pert-p" value="24" class="w-full border p-2 rounded text-sm">
                                    </div>
                                </div>
                                <button onclick="calculatePert()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded text-sm transition-colors">
                                    Calcular Tiempos Críticos
                                </button>
                                <div id="pert-result" class="p-3 bg-blue-50 text-blue-900 rounded text-sm font-semibold hidden"></div>
                            </div>
                        </div>

                        <div class="bg-white p-6 rounded-lg shadow-sm">
                            <h3 class="text-lg font-bold mb-2 text-slate-900">Predicción de Pérdida de Clientes sin Seguimiento de Planta</h3>
                            <p class="text-xs text-gray-500 mb-4">Cálculo de probabilidad cuando la agencia central no tiene visibilidad del cliente por fallas de reportes.</p>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-xs text-gray-600">Nivel de Transparencia de Datos del Concesionario</label>
                                    <select id="churn-visitas" class="w-full border p-2 rounded text-sm">
                                        <option value="alta">Opaco (El concesionario oculta el perfil)</option>
                                        <option value="baja">Transparente (Sincronizado vía CRM)</option>
                                    </select>
                                </div>
                                <button onclick="predictChurn()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 rounded text-sm transition-colors">
                                    Analizar Riesgo de Retención
                                </button>
                                <div id="churn-result" class="p-3 border rounded text-sm font-semibold hidden"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="tab-decision" class="tab-content space-y-6 hidden">
                    <div class="bg-white p-6 rounded-lg shadow-sm">
                        <h3 class="text-lg font-bold mb-2">Evaluación Económica del Retorno: Sistema de Incentivos</h3>
                        <p class="text-sm text-gray-500 mb-6">Determina si los costos de otorgar bonos de comisión superan las ganancias de recuperar la base de datos de los 55 concesionarios.</p>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-4 border-r pr-6">
                                <h4 class="font-bold text-slate-700">Costos de la Estrategia Propia</h4>
                                <div>
                                    <label class="block text-xs text-gray-600">Costo de Implementación PRM en Red (USD)</label>
                                    <input type="number" id="calc-build-dev" value="55000" class="w-full border p-2 rounded text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs text-gray-600">Fondo de Bonos Mensual por Agencia Compartida (USD)</label>
                                    <input type="number" id="calc-build-maint" value="500" class="w-full border p-2 rounded text-sm">
                                </div>
                            </div>
                            <div class="space-y-4">
                                <h4 class="font-bold text-slate-700">Pérdida por Ocultamiento de Datos (Línea Base)</h4>
                                <div>
                                    <label class="block text-xs text-gray-600">Costo de No Conocer al Cliente (Campañas Fallidas / USD)</label>
                                    <input type="number" id="calc-saas-init" value="15000" class="w-full border p-2 rounded text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs text-gray-600">Pérdida de Ventas Cruzadas Mensuales Estimadas (USD)</label>
                                    <input type="number" id="calc-saas-monthly" value="8500" class="w-full border p-2 rounded text-sm">
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t">
                            <button onclick="calculateDecisionTree()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded text-sm transition-colors">
                                Desplegar Árbol de Decisiones Financiero
                            </button>
                            <div id="decision-result" class="mt-4 p-4 bg-emerald-50 text-emerald-900 rounded text-sm font-medium hidden leading-relaxed"></div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script>
        // ESTADO DE LA APLICACIÓN
        let clients = [
            { id: 1, name: "Robert Harrison", email: "rharrison@ontario.ca", model: "Mercedes-Benz EQE Sedan", dealerId: 1 },
            { id: 2, name: "Chantal Lefebvre", email: "chantal.l@quebec.com", model: "Mercedes-AMG SL Roadster", dealerId: 2 }
        ];

        let dealers = [
            { id: 1, name: "Downtown Toronto Mercedes", region: "Ontario", compliance: 85, baseCommission: 5 },
            { id: 2, name: "Mercedes-Benz Montreal East", region: "Quebec", compliance: 40, baseCommission: 5 },
            { id: 3, name: "Vancouver Luxury Motors", region: "British Columbia", compliance: 92, baseCommission: 5 },
            { id: 4, name: "Calgary West Performance", region: "Alberta", compliance: 15, baseCommission: 5 }
        ];

        const TOTAL_NETWORK_DEALERS = 55;

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            const btnIds = ['dashboard', 'crm', 'prm', 'analytics', 'decision'];
            btnIds.forEach(id => {
                const btn = document.getElementById(`btn-${id}`);
                if(id === tabId) {
                    btn.classList.add('bg-slate-800', 'text-white');
                    btn.classList.remove('text-slate-300');
                } else {
                    btn.classList.remove('bg-slate-800', 'text-white');
                    btn.classList.add('text-slate-300');
                }
            });

            const titles = {
                dashboard: "Central de Monitoreo",
                crm: "Módulo CRM (Clientes Finales)",
                prm: "Auditoría de la Red de Distribución (Estrategia de Incentivos)",
                analytics: "Planificación del Módulo de Integración (PERT)",
                decision: "Evaluación Económica del Retorno: Sistema de Incentivos"
            };
            document.getElementById('page-title').innerText = titles[tabId];
            updateAll();
        }

        function updateAll() {
            renderKPIs();
            renderCRMTable();
            renderPRMTable();
            populateDealerDropdown();
        }

        function renderKPIs() {
            document.getElementById('kpi-total-dealers').innerText = `${dealers.length} / ${TOTAL_NETWORK_DEALERS}`;
            document.getElementById('kpi-total-clients').innerText = clients.length;
            
            const avgCompliance = dealers.reduce((acc, d) => acc + d.compliance, 0) / dealers.length;
            document.getElementById('kpi-data-index').innerText = `${avgCompliance.toFixed(0)}%`;

            const activeIncentives = dealers.filter(d => d.compliance >= 70).length;
            document.getElementById('kpi-incentives-unlocked').innerText = activeIncentives;
        }

        function renderCRMTable() {
            const tbody = document.getElementById('table-crm-body');
            tbody.innerHTML = '';
            clients.forEach(c => {
                const dealer = dealers.find(d => d.id === c.dealerId);
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50 text-xs">
                        <td class="p-3 font-bold">${c.name}<br><span class="text-gray-400 font-normal">${c.email}</span></td>
                        <td class="p-3 text-gray-600">${c.model}</td>
                        <td class="p-3 font-medium text-slate-700">${dealer ? dealer.name : 'Desconocido'}</td>
                        <td class="p-3 text-right"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold">Consolidado en HQ</span></td>
                    </tr>
                `;
            });
        }

        function renderPRMTable() {
            const tbody = document.getElementById('table-prm-body');
            tbody.innerHTML = '';
            dealers.forEach(d => {
                const thresholdPassed = d.compliance >= 70;
                const statusBadge = thresholdPassed 
                    ? '<span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded-full font-bold">🔓 Desbloqueado (Leads VIP)</span>'
                    : '<span class="bg-rose-100 text-rose-800 text-xs px-2.5 py-0.5 rounded-full font-bold">🔒 Bloqueado (Falta Información)</span>';
                const currentCommission = thresholdPassed ? d.baseCommission + 2 : d.baseCommission;

                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50 text-xs">
                        <td class="p-3 font-bold text-gray-800">${d.name}</td>
                        <td class="p-3 text-gray-600">${d.region}</td>
                        <td class="p-3">
                            <div class="flex items-center space-x-2">
                                <span class="font-bold">${d.compliance}%</span>
                                <div class="w-24 bg-gray-200 rounded-full h-1.5">
                                    <div class="bg-blue-600 h-1.5 rounded-full" style="width: ${d.compliance}%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="p-3 font-bold text-slate-900">${currentCommission}%</td>
                        <td class="p-3">${statusBadge}</td>
                    </tr>
                `;
            });
        }

        function populateDealerDropdown() {
            const select = document.getElementById('crm-dealer-origin');
            if(select) {
                select.innerHTML = '';
                dealers.forEach(d => {
                    select.innerHTML += `<option value="${d.id}">${d.name}</option>`;
                });
            }
        }

        function addClient(e) {
            e.preventDefault();
            const name = document.getElementById('crm-name').value;
            const email = document.getElementById('crm-email').value;
            const model = document.getElementById('crm-model').value;
            const dealerId = parseInt(document.getElementById('crm-dealer-origin').value);

            clients.push({ id: Date.now(), name, email, model, dealerId });
            
            const dealer = dealers.find(d => d.id === dealerId);
            if(dealer && dealer.compliance < 95) dealer.compliance += 5;

            document.getElementById('form-crm').reset();
            updateAll();
        }

        function simulateDataSync() {
            dealers.forEach(d => {
                if(d.compliance < 70) d.compliance += 35;
            });
            updateAll();
        }

        function calculatePert() {
            const o = parseFloat(document.getElementById('pert-o').value);
            const m = parseFloat(document.getElementById('pert-m').value);
            const p = parseFloat(document.getElementById('pert-p').value);
            if(!isNaN(o) && !isNaN(m) && !isNaN(p)) {
                const te = (o + (4 * m) + p) / 6;
                const div = document.getElementById('pert-result');
                div.innerHTML = `⏱️ Tiempo Esperado de Interconexión Total (Te): <span class="font-bold underline">${te.toFixed(2)} semanas</span> para estabilizar las 55 agencias.`;
                div.classList.remove('hidden');
            }
        }

        // FUNCIÓN CORREGIDA CON MANEJO SEGURO DE CLASES DE TAILWIND
        function predictChurn() {
            const visitas = document.getElementById('churn-visitas').value;
            const div = document.getElementById('churn-result');
            
            // Reseteamos clases de diseño previas para evitar conflictos
            div.classList.remove('hidden', 'bg-red-50', 'text-red-900', 'border-red-200', 'bg-green-50', 'text-green-900', 'border-green-200');
            
            if(visitas === 'alta') {
                div.innerHTML = `⚠️ Riesgo Crítico: Al mantener datos "Opacos", el ciclo de retención cae al 22%. HQ no puede enviar campañas de renovación automatizadas de fin de contrato.`;
                div.classList.add('bg-red-50', 'text-red-900', 'border-red-200');
            } else {
                div.innerHTML = `✅ Retención Asegurada: Con datos integrados, la probabilidad de recompra aumenta a un 85% gracias a la personalización de planta.`;
                div.classList.add('bg-green-50', 'text-green-900', 'border-green-200');
            }
        }

        function calculateDecisionTree() {
            const buildDev = parseFloat(document.getElementById('calc-build-dev').value);
            const buildMaint = parseFloat(document.getElementById('calc-build-maint').value);
            const lossInit = parseFloat(document.getElementById('calc-saas-init').value);
            const lossMonthly = parseFloat(document.getElementById('calc-saas-monthly').value);

            const inversionInicial = buildDev + lossInit; 
            const recuperacionMensual = lossMonthly - buildMaint;
            const breakeven = inversionInicial / recuperacionMensual;

            const div = document.getElementById('decision-result');
            div.classList.remove('hidden');
            div.innerHTML = `
                <strong>Resultado del Análisis del Árbol Financiero:</strong><br>
                • Inversión de Mitigación Inicial (Software + Despliegue): $${inversionInicial.toFixed(2)} USD.<br>
                • Pérdida Mensual Evitada (Retorno de Campañas Exitosas): $${recuperacionMensual.toFixed(2)} USD.<br>
                • <strong>Punto de Retorno de la Inversión:</strong> <span class="font-bold text-base text-slate-900 underline">${breakeven.toFixed(1)} meses</span>.<br><br>
                <em>Conclusión:</em> Romper la opacidad de la red de concesionarios se paga solo en menos de un año, recuperando el control de los clientes finales.
            `;
        }

        updateAll();
    </script>
</body>
</html>
